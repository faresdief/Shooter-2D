{
  "rules": {
    ".read": false,
    ".write": false,
    "tds": {
      "$topic": {
        ".read": "$topic.matches(/^tdsq-[A-Za-z0-9]{1,12}$/)",
        ".write": "$topic.matches(/^tdsq-[A-Za-z0-9]{1,12}$/) && $topic != 'tdsq-lobby1'",
        "$msg": {
          ".write": "$topic.matches(/^tdsq-[A-Za-z0-9]{1,12}$/) && (!data.exists() || !newData.exists())",
          ".validate": "newData.hasChild('m')",
          "m": {
            ".validate": "newData.isString() && newData.val().length <= 30000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "tds-scores": {
      ".read": true,
      ".indexOn": [
        "s"
      ],
      "$id": {
        ".write": "!data.exists() && newData.exists()",
        ".validate": "$id.matches(/^-[A-Za-z0-9_-]{19}$/) && newData.hasChildren(['n','s','t'])",
        "n": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 14"
        },
        "s": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 10000000 && newData.val() % 1 == 0"
        },
        "t": {
          ".validate": "newData.isNumber() && newData.val() >= now - 60000 && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
